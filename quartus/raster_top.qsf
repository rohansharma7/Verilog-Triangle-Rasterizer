# pins for the DueProLogic Cyclone IV board (EP4CE6E22C8).
# taken from the DueProLogic user manual. it doesn't have the full 54-pin
# GPIO table so everything goes through the two PMOD headers instead,
# those are the only pins with a clear pinout.
#
# careful: the manual lists SW1/SW2 at the same pins as the slide switches,
# probably a typo in their doc. check PIN_91 against the schematic before
# trusting it for rst_n

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY raster_top

# 66MHz oscillator. there's also a 100MHz one on PIN_88 if I ever want it,
# but display_driver's hold cycles would need recalculating
set_location_assignment PIN_23 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

# SW1, grounds when pressed and pulled high otherwise, so active-low already
set_location_assignment PIN_91 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# touch controller (XPT2046), PMOD1 pins 1-1 to 1-7
set_location_assignment PIN_121 -to T_CS
set_location_assignment PIN_124 -to T_DIN
set_location_assignment PIN_125 -to T_CLK
set_location_assignment PIN_126 -to T_DO
set_location_assignment PIN_120 -to T_IRQ

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to T_CS
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to T_DIN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to T_CLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to T_DO
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to T_IRQ

# display (ILI9341), rest of PMOD1 plus PMOD2 2-1/2-2/2-3
set_location_assignment PIN_119 -to CS
set_location_assignment PIN_115 -to RESET
set_location_assignment PIN_114 -to DC
set_location_assignment PIN_67  -to SDI
set_location_assignment PIN_66  -to SCK
set_location_assignment PIN_53  -to LED

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CS
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to RESET
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DC
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SDI
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SCK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED

# spare PMOD2 pins if I need them: PIN_52, 55, 54, 69, 70

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name SDC_FILE raster_top.sdc
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/touchscreen_interface.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/screen_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rasterizer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/raster_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/display_interface.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/display_driver.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/cmd_processor.sv
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top